# ビルドのたびに build_id.h を書き出す。
# configure 時の値をコンパイル定義に埋めると、cmake を再実行するまで
# 古い日時/SHA が残って「焼いたビルドが分からない」状態になるため、
# 毎ビルド走る custom target から生成する (BL-45 の焼き間違い検出用)。
string(TIMESTAMP BUILD_TIME "%Y-%m-%d %H:%M:%S")

set(BUILD_SHA "unknown")
execute_process(COMMAND git rev-parse --short HEAD
    WORKING_DIRECTORY ${SRC_DIR}
    OUTPUT_VARIABLE _sha
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE _rc)
if(_rc EQUAL 0 AND _sha)
    set(BUILD_SHA "${_sha}")
endif()

execute_process(COMMAND git status --porcelain
    WORKING_DIRECTORY ${SRC_DIR}
    OUTPUT_VARIABLE _dirty
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET)
if(_dirty)
    string(APPEND BUILD_SHA "+dirty")
endif()

file(WRITE ${OUT_HEADER}
    "// generated by cmake/gen_build_id.cmake - do not edit\n#pragma once\n#define REMAPPER_BUILD_TIME \"${BUILD_TIME}\"\n#define REMAPPER_GIT_SHA \"${BUILD_SHA}\"\n")
